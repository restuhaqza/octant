    "@angular-eslint/eslint-plugin-template": "22.5.0",
    "@angular-eslint/schematics": "22.5.0",
    "@angular-eslint/template-parser": "22.5.0",
    "@angular-devkit/build-angular": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/language-service": "^22.2.0",
    "@babel/core": "^7.11.6",
    "@mdx-js/loader": "^1.6.18",
    "@storybook/addon-a11y": "v6.3.8",
    "@storybook/addon-actions": "v6.3.8",
    "@storybook/addon-console": "^1.2.3",
    "@storybook/addon-controls": "v6.3.8",
    "@storybook/addon-docs": "v6.3.8",
    "@storybook/addon-links": "v6.3.8",
    "@storybook/addons": "v6.3.8",
    "@storybook/angular": "v6.3.8",
    "@storybook/builder-webpack5": "^6.3.8",
    "@storybook/codemod": "v6.3.8",
    "@storybook/manager-webpack5": "^6.3.8",
    "@storybook/theming": "v6.3.8",
    "@types/d3": "~5.16.3",
    "@types/graphlib-dot": "^0.6.1",
    "@types/jasmine": "~4.3.0",
    "@types/lodash": "^4.14.172",
    "@types/node": "^16.9.4",
    "@types/ws": "^7.4.4",
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "angular-eslint": "22.5.0",
    "babel-loader": "^8.1.0",
    "dayjs": "^1.9.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.0.0",
    "jasmine-core": "~4.5.0",
    "karma": "^6.3.2",
    "karma-chrome-launcher": "^3.1.0",
    "karma-coverage": "^2.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^1.5.4",
    "karma-spec-reporter": "0.0.32",
    "marked": "^2.0.1",
    "mini-css-extract-plugin": "^2.2.0",
    "prettier": "2.4.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "rimraf": "^3.0.2",
    "ts-loader": "^8.0.4",
