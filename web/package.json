{
  "name": "octant",
  "description": "Octant is an extensible platform that provides modules that help developers better understand their Kubernetes resources.",
  "author": "The Octant contributors",
  "version": "0.26.0",
  "homepage": "https://github.com/restuhaqza/octant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/restuhaqza/octant.git"
  },
  "bugs": {
    "url": "https://github.com/restuhaqza/octant/issues"
  },
  "main": "main.js",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node ./node_modules/@angular/cli/bin/ng build --configuration production --output-hashing=all",
    "build-electron": "npx tsc -p tsconfig.serve.json && npm run build -- --base-href ./",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:headless": "ng test --watch=false --browsers=ChromeHeadless --source-map=false",
    "lint": "ng lint && prettier -c \"src/**/*.ts\"",
    "lint:fix": "ng lint --fix",
    "clean": "rimraf ./dist/octant/*",
    "prettier": "prettier --write \"src/{app,environments,assets}/**/*{.ts,.js,.json,.css,.scss}\"",
    "electron:serve": "wait-on http-get://localhost:7777 && npm run electron:serve-tsc && electron . --serve",
    "electron:serve-tsc": "npx tsc -p tsconfig.serve.json",
    "electron:local": "npx tsc -p tsconfig.serve.json && npx ng build --base-href ./ && npx electron --local .",
    "electron:build": "npm run build-electron && npx electron-builder -p never",
    "storybook": "start-storybook -p 6006 -s src/assets",
    "build-storybook": "node ./node_modules/@storybook/angular/bin/build.js build-storybook -c .storybook",
    "postinstall": "rimraf ./node_modules/cytoscape-node-html-label/dist/cytoscape-node-html-label.d.ts"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "arrowParens": "avoid",
    "singleQuote": true
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/elements": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@cds/angular": "^6.17.0",
    "@cds/city": "^1.1.0",
    "@cds/core": "^6.17.0",
    "@clr/angular": "^18.4.0",
    "@clr/icons": "^13.0.2",
    "@clr/ui": "^18.4.0",
    "@materia-ui/ngx-monaco-editor": "^6.0.0",
    "@ng-select/ng-select": "^24.2.1",
    "@types/cytoscape": "^3.14.12",
    "@types/overlayscrollbars": "^1.12.0",
    "@webcomponents/custom-elements": "^1.5.0",
    "angular-resizable-element": "^7.0.2",
    "ansi_up": "^5.0.0",
    "core-js": "^3.16.1",
    "cytoscape": "^3.18.1",
    "cytoscape-cose-bilkent": "^4.1.0",
    "cytoscape-dagre": "^2.3.0",
    "cytoscape-node-html-label": "^1.2.2",
    "d3-graphviz": "^2.6.1",
    "d3-zoom": "^2.0.0",
    "dagre-d3": "^0.6.4",
    "electron-store": "^7.0.0",
    "get-port": "^5.1.1",
    "highlight.js": "^11.8.0",
    "jscodeshift": "^0.12.0",
    "jsoneditor": "^9.4.1",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "monaco-editor": "^0.21.2",
    "ngx-highlightjs": "^11.0.1",
    "open": "^8.0.7",
    "overlayscrollbars-ngx": "^0.5.2",
    "rxjs": "^7.5.0",
    "serialize-javascript": "^5.0.1",
    "tslib": "^2.0.3",
    "ws": "^7.4.6",
    "xterm": "^4.9.0",
    "xterm-addon-fit": "^0.4.0",
    "zone.js": "~0.16.0",
    "@angular/cdk": "^22.2.2",
    "overlayscrollbars": "^2.0.0"
  },
